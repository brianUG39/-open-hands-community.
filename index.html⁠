ns{display:flex;gap:12px;flex-wrap:wrap;margin-top:26px}.micro{font-size:.84rem!important;margin-top:16px}.hero-photo{position:relative}.hero-photo img{width:100%;height:490px;object-fit:cover;border-radius:34px 34px 120px 34px;display:block;background:#dbe4d8}.photo-note{position:absolute;bottom:20px;left:-22px;background:white;padding:17px 20px;border-radius:18px;box-shadow:0 12px 40px #163b2c1c;max-width:230px}.photo-note strong{display:block;font-size:1.1rem}.photo-note span{font-size:.85rem;color:var(--muted)}.strip{background:var(--green);color:white;padding:22px 0}.strip-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.strip-item{display:flex;align-items:center;gap:14px}.strip-icon{width:44px;height:44px;border-radius:14px;background:#ffffff1c;display:grid;place-items:center;font-size:22px;flex-shrink:0}.strip-item strong{display:block}.strip-item span{font-size:.86rem;color:#d8e6dc}section{padding:82px 0}.section-head{text-align:center;max-width:680px;margin:0 auto 38px}.section-head .eyebrow{margin-bottom:12px}.section-head h2{font-size:clamp(2rem,3.5vw,3.1rem);letter-spacing:-1.6px;line-height:1.1;margin:8px 0 14px}.section-head p{color:var(--muted);margin:0}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.card{background:white;border:1px solid var(--line);border-radius:24px;overflow:hidden;box-shadow:0 8px 30px #1b49340a}.card img{width:100%;height:205px;object-fit:cover;display:block;background:#e4e9df}.card-body{padding:23px}.card h3{margin:0 0 8px;font-size:1.25rem}.card p{color:var(--muted);font-size:.95rem;margin:0 0 18px}.text-link{font-weight:850;color:var(--green);text-decoration:none}.how{background:#edf1e8}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:22px}.step{padding:25px;background:#fff;border-radius:22px}.num{width:40px;height:40px;border-radius:13px;background:#e5eee5;color:var(--green);display:grid;place-items:center;font-weight:900}.step h3{margin:16px 0 7px}.step p{margin:0;color:var(--muted);font-size:.94rem}.give-grid{display:grid;grid-template-columns:.9fr 1.1fr;gap:45px;align-items:start}.give-copy h2{font-size:clamp(2.2rem,4vw,3.5rem);line-height:1.08;letter-spacing:-1.8px;margin:15px 0}.give-copy p{color:var(--muted)}.give-list{list-style:none;padding:0;margin:22px 0}.give-list li{margin:10px 0}.give-list li:before{content:"✓";color:var(--green2);font-weight:900;margin-right:10px}.formbox{background:white;border:1px solid var(--line);border-radius:26px;padding:28px;box-shadow:0 12px 36px #163b2c0b}.formbox h3{margin:0 0 6px;font-size:1.45rem}.formbox>p{color:var(--muted);margin:0 0 20px;font-size:.92rem}.field{margin:14px 0}.field label{display:block;font-weight:750;font-size:.88rem;margin-bottom:6px}.field input,.field select,.field textarea{width:100%;border:1px solid #dce2d9;border-radius:12px;padding:12px 13px;background:#fcfcf9;color:var(--ink)}.field textarea{min-height:85px;resize:vertical}.two{display:grid;grid-template-columns:1fr 1fr;gap:12px}.formbox .btn{width:100%;margin-top:5px}.notice{font-size:.78rem;color:#77837b;margin-top:12px}.impact{background:#f8e9c9}.impact-inner{display:grid;grid-template-columns:1fr 1fr;gap:35px;align-items:center}.impact h2{font-size:clamp(2rem,3.6vw,3.1rem);line-height:1.1;letter-spacing:-1.4px;margin:10px 0}.impact p{color:#615b4b}.impact-photo{width:100%;height:350px;object-fit:cover;border-radius:28px}.quote{font-size:1.18rem;font-weight:700;line-height:1.5}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:35px}.contact-card{background:white;border:1px solid var(--line);border-radius:24px;padding:28px}.contact-card h3{margin-top:0}.contact-card p{color:var(--muted)}.contact-line{padding:13px 0;border-bottom:1px solid var(--line)}.contact-line:last-child{border-bottom:0}footer{background:#102f25;color:white;padding:34px 0}.footer-row{display:flex;justify-content:space-between;align-items:center;gap:20px;flex-wrap:wrap}.footer-row p{color:#c9d9cf;font-size:.86rem;margin:6px 0 0}.footer-links{display:flex;gap:18px;flex-wrap:wrap}.footer-links a{color:#e5eee7;text-decoration:none;font-size:.88rem}.smallprint{font-size:.78rem;color:#c9d9cf;margin-top:22px;max-width:850px}@media(max-width:800px){.links{display:none;position:absolute;top:76px;left:0;right:0;background:var(--cream);padding:18px 5%;border-bottom:1px solid var(--line);flex-direction:column;align-items:stretch}.links.open{display:flex}.menu{display:block}.hero{padding:38px 0 54px}.hero-grid,.give-grid,.impact-inner,.contact-grid{grid-template-columns:1fr}.hero-grid{gap:35px}.hero-photo img{height:360px;border-radius:28px 28px 90px 28px}.photo-note{left:10px}.strip-grid{grid-template-columns:1fr;gap:15px}.cards,.steps{grid-template-columns:1fr}.card img{height:230px}section{padding:60px 0}.give-grid{gap:25px}.impact-photo{height:280px}.hero h1{letter-spacing:-2px}.two{grid-template-columns:1fr}}
</style></head><body>
<header><div class="wrap nav"><a class="brand" href="#home"><span class="mark">♡</span><span>Open Hands <span style="color:#548268">Community</span></span></a><button class="menu" aria-label="Open menu" onclick="document.querySelector('.links').classList.toggle('open')">☰</button><nav class="links"><a href="#mission">Our mission</a><a href="#how">How it works</a><a href="#give">Give support</a><a href="#contact">Contact</a><a class="btn btn-primary" href="#give">Make a difference ↗</a></nav></div></header>
<main><section class="hero" id="home"><div class="wrap hero-grid"><div><span class="eyebrow"><span class="dot"></span> Kindness has no limits</span><h1>Small acts.<br><em>Brighter futures.</em></h1><p>Everyone deserves care, dignity and a chance to thrive. Together, we can support children without parental care, people with disabilities, deaf communities and families facing hardship.</p><div class="actions"><a class="btn btn-primary" href="#give">♡ Give what you can</a><a class="btn" style="border:1px solid #d8dfd5" href="#mission">Discover our mission ↓</a></div><p class="micro">Money, food, clothes, school supplies, mobility aids, skills or your time — every kind of help matters.</p></div><div class="hero-photo"><img src="https://images.unsplash.com/photo-1488521787991-ed7bbaae773c?auto=format&fit=crop&w=1200&q=85" alt="Children spending time together in a caring community setting"><div class="photo-note"><strong>Every person matters.</strong><span>Support that starts with dignity and respect.</span></div></div></div></section>
<div class="strip"><div class="wrap strip-grid"><div class="strip-item"><div class="strip-icon">🤝</div><div><strong>Give in your own way</strong><span>Goods, services, money or time</span></div></div><div class="strip-item"><div class="strip-icon">♿</div><div><strong>Inclusion for everyone</strong><span>Respect, access and opportunity</span></div></div><div class="strip-item"><div class="strip-icon">🌱</div><div><strong>Community-led care</strong><span>Practical help with dignity</span></div></div></div></div>
<section id="mission"><div class="wrap"><div class="section-head"><span class="eyebrow">Who we stand with</span><h2>Care should reach everyone.</h2><p>We want to connect willing supporters with people and community groups who need practical help. Every person deserves to be seen, heard and included.</p></div><div class="cards"><article class="card"><img src="https://images.unsplash.com/photo-1503454537195-1dcabb73ffb9?auto=format&fit=crop&w=900&q=80" alt="Children learning and playing together" loading="lazy"><div class="card-body"><h3>Children & young people</h3><p>Help with learning materials, meals, safe spaces, clothing and opportunities to grow.</p><a class="text-link" href="#give">Support children →</a></div></article><article class="card"><img src="https://images.unsplash.com/photo-1531123897727-8f129e1688ce?auto=format&fit=crop&w=900&q=80" alt="A confident young woman smiling" loading="lazy"><div class="card-body"><h3>People with disabilities</h3><p>Support accessibility, mobility equipment, inclusive activities and everyday essentials.</p><a class="text-link" href="#give">Support inclusion →</a></div></article><article class="card"><img src="https://images.unsplash.com/photo-1511632765486-a01980e01a18?auto=format&fit=crop&w=900&q=80" alt="People gathered together in a supportive community" loading="lazy"><div class="card-body"><h3>Deaf people & families</h3><p>Help strengthen inclusion, communication access, learning and community connection.</p><a class="text-link" href="#give">Support access →</a></div></article></div></div></section>
<section class="how" id="how"><div class="wrap"><div class="section-head"><span class="eyebrow">Simple, meaningful help</span><h2>Three steps to make a difference.</h2><p>Start with what you have. You don't need to be wealthy to be part of a kinder community.</p></div><div class="steps"><div class="step"><div class="num">01</div><h3>Choose how to help</h3><p>Offer money, food, clothes, books, hygiene items, equipment, professional skills or volunteer time.</p></div><div class="step"><div class="num">02</div><h3>Tell us what you can give</h3><p>Send your offer and contact details so the team can discuss safe, practical arrangements with you.</p></div><div class="step"><div class="num">03</div><h3>Coordinate responsibly</h3><p>Confirm the recipient, delivery or payment method, and how support will be acknowledged before anything changes hands.</p></div></div></div></section>
<section id="give"><div class="wrap give-grid"><div class="give-copy"><span class="eyebrow">Your kindness counts</span><h2>You don't have to give a lot. Just give what you can.</h2><p>Support is more than money. A bag of rice, a school bag, clean clothes, a wheelchair in good condition, sign-language skills or a few hours of volunteering can all make a difference.</p><ul class="give-list"><li>Money or mobile-money support</li><li>Food, clothes and household essentials</li><li>Books, school supplies and learning tools</li><li>Wheelchairs, crutches and accessibility items</li><li>Professional services and volunteer time</li></ul><p><strong>Important:</strong> This is an early website draft. Please contact the organisers to confirm needs and safe delivery arrangements before sending money or goods.</p></div><div class="formbox"><h3>Offer your support</h3><p>Fill this in to prepare a message about how you'd like to help.</p><form id="supportForm"><div class="two"><div class="field"><label for="name">Your name</label><input id="name" required placeholder="Name"></div><div class="field"><label for="contactInfo">Phone or email</label><input id="contactInfo" required placeholder="How can we reach you?"></div></div><div class="field"><label for="kind">What would you like to give?</label><select id="kind" required><option value="">Choose support type</option><option>Money / mobile money</option><option>Food and essentials</option><option>Clothes and shoes</option><option>Books and school supplies</option><option>Disability / accessibility equipment</option><option>Volunteer time or professional skills</option><option>Other donation</option></select></div><div class="field"><label for="details">Tell us a little more</label><textarea id="details" placeholder="What can you offer? Any questions?"></textarea></div><button class="btn btn-primary" type="submit">Prepare support message ↗</button><p class="notice">This form does not send data to a server. It opens your email app with a draft message; no message is sent until you choose to send it.</p><div id="formMessage" role="status" style="font-size:.9rem;margin-top:10px"></div></form></div></div></section>
<section class="impact"><div class="wrap impact-inner"><div><span class="eyebrow">Dignity first</span><h2>Help should empower, not define a person.</h2><p class="quote">“The best support is given with respect, listens to what people actually need, and helps communities build lasting opportunities.”</p><p>We aim to work with local community organisations and people with lived experience to make support respectful, useful and accountable.</p><a class="btn btn-primary" href="#contact">Let's work together</a></div><img class="impact-photo" src="https://images.unsplash.com/photo-1517486808906-6ca8b3f04846?auto=format&fit=crop&w=1100&q=85" alt="Young people standing together in a community" loading="lazy"></div></section>
<section id="contact"><div class="wrap"><div class="section-head"><span class="eyebrow">Get involved</span><h2>Let's make kindness practical.</h2><p>Are you a donor, volunteer, community leader or organisation interested in working together?</p></div><div class="contact-grid"><div class="contact-card"><h3>Partner with us</h3><p>We welcome conversations with schools, disability organisations, deaf associations, child-care organisations, local leaders and responsible donors.</p><a class="btn btn-primary" href="#give">Offer support</a></div><div class="contact-card"><h3>Contact details</h3><p>These details need to be completed by the website owner before launch.</p><div class="contact-line"><strong>📍 Location</strong><br>Uganda — service areas to be confirmed</div><div class="contact-line"><strong>✉️ Email</strong><br><span>Replace with your official charity email</span></div><div class="contact-line"><strong>📞 Phone / WhatsApp</strong><br><span>Replace with your official contact number</span></div></div></div></div></section></main>
<footer><div class="wrap"><div class="footer-row"><div class="brand"><span class="mark">♡</span><span>Open Hands Community</span></div><div class="footer-links"><a href="#mission">Our mission</a><a href="#give">Give support</a><a href="#contact">Contact</a></div></div><p class="smallprint">Open Hands Community is a proposed project name and this page is a starter website template, not proof of a registered charity. Before accepting donations, add verified contact details, confirm your legal/organisational status, publish a privacy and safeguarding policy, and set up a secure, traceable donation process. Never publish private details or photos of children without appropriate consent.</p><p class="smallprint">© <span id="year"></span> Open Hands Community. Built around dignity, inclusion and community care.</p></div></footer>
<script>document.getElementById('year').textContent=new Date().getFullYear();document.getElementById('supportForm').addEventListener('submit',function(e){e.preventDefault();const name=document.getElementById('name').value.trim(),contact=document.getElementById('contactInfo').value.trim(),kind=document.getElementById('kind').value,details=document.getElementById('details').value.trim();const subject=encodeURIComponent('Offer of support — Open Hands Community');const body=encodeURIComponent('Hello Open Hands Community,\n\nI would like to offer support.\n\nName: '+name+'\nContact: '+contact+'\nSupport type: '+kind+'\nDetails: '+(details||'Not provided')+'\n\nPlease contact me to discuss next steps.\n');document.getElementById('formMessage').textContent='Opening your email app with a draft. Please add the official charity email address before sending.';window.location.href='mailto:?subject='+subject+'&body='+body;});document.querySelectorAll('.links a').forEach(a=>a.addEventListener('click',()=>document.querySelector('.links').classList.remove('open')));</script>
</body></html>
